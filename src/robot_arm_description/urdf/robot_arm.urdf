<?xml version="1.0"?>
<robot name="robot_arm">

  <!-- The fixed base -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.2 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- First moving link -->
  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <cylinder radius="0.025" length="0.5"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.4 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- First revolute joint -->
  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.025"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <!-- Second moving link -->
  <link name="forearm">
    <visual>
      <origin xyz="0 0 0.2"/>
      <geometry>
        <cylinder radius="0.02" length="0.4"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Second revolute joint -->
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

</robot>
