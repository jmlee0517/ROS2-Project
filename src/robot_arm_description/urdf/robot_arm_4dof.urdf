
<?xml version="1.0"?>
<robot name="robot_arm_4dof">

  <!-- Materials -->
  <material name="dark_gray">
    <color rgba="0.22 0.24 0.27 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.12 0.35 0.78 1.0"/>
  </material>

  <material name="orange">
    <color rgba="0.95 0.38 0.10 1.0"/>
  </material>

  <material name="light_gray">
    <color rgba="0.72 0.75 0.78 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.85 0.10 0.10 1.0"/>
  </material>

  <!-- ===================================================== -->
  <!-- BASE                                                   -->
  <!-- ===================================================== -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.06"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.00030" ixy="0" ixz="0"
               iyy="0.00030" iyz="0"
               izz="0.00040"/>
    </inertial>
  </link>

  <!-- Rotating turret -->
  <link name="base_rotation_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.00008" ixy="0" ixz="0"
               iyy="0.00008" iyz="0"
               izz="0.00010"/>
    </inertial>
  </link>

  <joint name="base_rotation_joint" type="revolute">
    <parent link="base_link"/>
    <child link="base_rotation_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708"
           effort="1.0" velocity="0.8"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- ===================================================== -->
  <!-- SHOULDER                                               -->
  <!-- ===================================================== -->

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.055 0.035"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.055 0.035"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.06"/>
      <inertia ixx="0.00002" ixy="0" ixz="0"
               iyy="0.00002" iyz="0"
               izz="0.00002"/>
    </inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_rotation_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7854" upper="1.3090"
           effort="6.5" velocity="0.8"/>
    <dynamics damping="0.08" friction="0.03"/>
  </joint>

  <!-- Upper arm: 120 mm -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.035 0.12"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.028 0.035 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.045"/>
      <inertia ixx="0.00007" ixy="0" ixz="0"
               iyy="0.00007" iyz="0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="upper_arm_fixed_joint" type="fixed">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.0175" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================== -->
  <!-- ELBOW AND FOREARM                                      -->
  <!-- ===================================================== -->

  <!-- Forearm: 120 mm -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.032 0.12"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.032 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.035"/>
      <inertia ixx="0.00005" ixy="0" ixz="0"
               iyy="0.00005" iyz="0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944"
           effort="2.7" velocity="1.0"/>
    <dynamics damping="0.06" friction="0.02"/>
  </joint>

  <!-- ===================================================== -->
  <!-- WRIST                                                  -->
  <!-- ===================================================== -->

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.04 0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.04 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="wrist_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708"
           effort="1.0" velocity="1.2"/>
    <dynamics damping="0.04" friction="0.01"/>
  </joint>

  <!-- ===================================================== -->
  <!-- GRIPPER MOUNT                                          -->
  <!-- ===================================================== -->

  <link name="gripper_mount_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.05 0.05"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.05 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="gripper_mount_fixed_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="gripper_mount_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================== -->
  <!-- GRIPPER FINGERS                                        -->
  <!--                                                        -->
  <!-- At q=0, inner faces touch at y=0.                      -->
  <!-- At q=0.025 m, total opening is 0.050 m.                -->
  <!-- ===================================================== -->

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.012 0.05"/>
      </geometry>
      <material name="light_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.012 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.008"/>
      <inertia ixx="0.000002" ixy="0" ixz="0"
               iyy="0.000002" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="gripper_joint" type="prismatic">
    <parent link="gripper_mount_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 0.006 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.025"
           effort="5.0" velocity="0.03"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.012 0.05"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.012 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.008"/>
      <inertia ixx="0.000002" ixy="0" ixz="0"
               iyy="0.000002" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <joint name="right_finger_mimic_joint" type="prismatic">
    <parent link="gripper_mount_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 -0.006 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.025" upper="0"
           effort="5.0" velocity="0.03"/>
    <mimic joint="gripper_joint" multiplier="-1.0" offset="0"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <!-- ===================================================== -->
  <!-- END-EFFECTOR / GRASP CENTER                            -->
  <!-- ===================================================== -->

  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.006"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="end_effector_fixed_joint" type="fixed">
    <parent link="gripper_mount_link"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

</robot>
